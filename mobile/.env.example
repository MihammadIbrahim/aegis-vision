# Copy to mobile/.env (not committed). Expo inlines EXPO_PUBLIC_* values when it bundles the app.
# The Core API address as seen from the phone: the Android emulator reaches the development machine at 10.0.2.2;
# a physical phone needs the machine's LAN address, e.g. http://192.168.1.20:8000 (or an https:// address).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
# Must equal the server's MANUAL_REPORT_PHOTO_MAX_BYTES (5 MB by default).
EXPO_PUBLIC_MANUAL_REPORT_PHOTO_MAX_BYTES=5000000
