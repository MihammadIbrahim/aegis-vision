# Copy to .env and fill in. Never commit .env.

# --- Platform Super Admin: INITIAL credentials (used only by the seed command) ---
# Creates the database account once:  cd services/core_api && python -m src.entrypoints.seed_super_admin
# Later runs never overwrite it. After the first login, change the username and password
# through the API; the database values then win. '--reset-password' puts these values back.
# admin / admin@123 are local-development defaults only. Never use them on a shared server.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin@123

# --- Platform Super Admin: EMERGENCY RECOVERY credentials (read by the API at startup) ---
# A second way in if the normal password is forgotten (there is no email reset for the
# Super Admin). Independent of the database credentials: changing those does not change
# these. Never stored in the database, logged, or returned by the API. Leave both blank
# to turn recovery off. Restart the API after changing them.
# SECURITY: anyone who can read this server's .env can log in as the Super Admin with these.
# Protect the server and this file; this is an emergency mechanism, not a substitute.
SUPER_ADMIN_RECOVERY_USERNAME=admin
SUPER_ADMIN_RECOVERY_PASSWORD=admin@123

# --- Super Admin login protection (applies to both methods) ---
PLATFORM_LOGIN_MAX_ATTEMPTS=5    # failed logins within the window that lock the account
PLATFORM_LOGIN_LOCKOUT_MINUTES=15

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cctv_security
POSTGRES_USER=                   # owner role: runs migrations only
POSTGRES_PASSWORD=
APP_DB_USER=cctv_app             # tenant role for organization users (cannot bypass RLS)
APP_DB_PASSWORD=
PLATFORM_DB_USER=cctv_platform   # Super Admin role; cannot read any organization's data
PLATFORM_DB_PASSWORD=
DATABASE_URL=postgresql+asyncpg://cctv_app:<APP_DB_PASSWORD>@postgres:5432/cctv_security
PLATFORM_DATABASE_URL=postgresql+asyncpg://cctv_platform:<PLATFORM_DB_PASSWORD>@postgres:5432/cctv_security
MIGRATION_DATABASE_URL=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/cctv_security

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_EXCHANGE=cctv.events

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=                  # at least 32 random characters, e.g. from: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Runtime environment ---
APP_ENV=development              # development | production ("development" allows the email outbox below)

# --- Email delivery (verification codes) ---
#   none        no provider: endpoints that must email a code answer 503 EMAIL_DELIVERY_NOT_CONFIGURED
#   brevo       real email through Brevo's HTTP API (fill in the BREVO_ values below)
#   dev_outbox  write each email to a file in DEV_OUTBOX_DIR instead of sending it (APP_ENV=development only)
EMAIL_DELIVERY_MODE=dev_outbox
DEV_OUTBOX_DIR=.dev_outbox       # relative to the folder you start the API from; git-ignored
BREVO_API_KEY=                   # Brevo dashboard > SMTP & API > API keys. Never commit it.
BREVO_SENDER_EMAIL=              # a sender address verified in your Brevo account
BREVO_SENDER_NAME=AI CCTV Security
EMAIL_SEND_TIMEOUT_SECONDS=10

# --- One-time codes (email OTP) ---
OTP_SECRET_KEY=                  # optional; at least 32 random characters. Blank = derived from JWT_SECRET_KEY
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5               # wrong codes allowed before a new code is needed
OTP_HOURLY_LIMIT=5               # codes sent to one email address per hour

# --- First Organization Admin registration ---
ORG_REGISTRATION_EXPIRE_MINUTES=60       # an unverified registration is erased after this
ORG_REGISTRATION_IP_LIMIT_PER_HOUR=30    # registration requests per client IP per hour (per API process)

# --- Organization Admin sign-in (credentials, then an email code, then a token) ---
ORG_LOGIN_MAX_ATTEMPTS=5                 # wrong passwords within the window that lock the account
ORG_LOGIN_LOCKOUT_MINUTES=15
ORG_LOGIN_EXPIRE_MINUTES=10              # time to enter the emailed code after the password check
ORG_LOGIN_IP_LIMIT_PER_HOUR=60           # sign-in requests per client IP per hour (per API process)

# --- Supervisor creation (Admin re-confirms password + email code first) ---
SUPERVISOR_AUTHORIZATION_EXPIRE_MINUTES=10   # time to enter the Admin's code
SUPERVISOR_FORM_EXPIRE_MINUTES=15            # after that, time to submit the form (once)
SUPERVISOR_CREATION_EXPIRE_MINUTES=30        # time to enter the Supervisor's email code
SUPERVISOR_PROFILE_CHANGE_EXPIRE_MINUTES=15  # time to confirm a Supervisor's own profile changes by code

# --- Password reset (Admins and Supervisors) ---
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_MINUTES=10              # time to set the new password after the code
PASSWORD_RESET_IP_LIMIT_PER_HOUR=30

# --- Delete Account and Main Admin ownership transfer ---
ACCOUNT_ACTION_VERIFY_MINUTES=10             # time to enter the emailed code
OWNERSHIP_TRANSFER_ACCEPT_HOURS=72           # how long the chosen Admin has to accept

# --- Alert Management ---
# Shared secret the AI workers send in the X-Detection-Token header. Leave empty to switch the
# detection intake off; put your own long random value only in your .env.
DETECTION_INGEST_TOKEN=
ALERT_DEDUP_SECONDS=60                       # repeats of an open alert (same camera and type) are merged
MANUAL_REPORT_PHOTO_MAX_BYTES=5000000

# --- Personnel Management and Excel/CSV import (decision D-016) ---
# There is no row limit: files are read as a stream. These limits protect the server; a file over a
# limit is refused as a whole with a clear message, and nothing is imported.
PERSONNEL_IMPORT_MAX_UPLOAD_BYTES=100000000          # size of the uploaded .xlsx / .csv
PERSONNEL_IMPORT_MAX_UNCOMPRESSED_BYTES=1000000000   # unpacked size of an .xlsx (zip-bomb guard)
PERSONNEL_IMPORT_FILE_RETENTION_HOURS=72             # uploaded and annotated files; unconfirmed imports then expire
PERSONNEL_IMPORT_CHUNK_ROWS=1000                     # rows per database round trip (not a limit)
PERSONNEL_PHOTO_MAX_BYTES=5000000

# --- CV pipeline (services/cv_inference; read from its own .env or the environment) ---
# CV_API_BASE_URL=http://127.0.0.1:8000
# CV_DETECTION_INGEST_TOKEN=                  # the same value as DETECTION_INGEST_TOKEN above
# CV_SAMPLE_FPS=5
# CV_MIN_CONSECUTIVE_FRAMES=3
# CV_COOLDOWN_SECONDS=10                      # must be shorter than ALERT_DEDUP_SECONDS
# CV_CLASS_MAP={"weapon": "WEAPON", "fight_violence": "FIGHT_VIOLENCE"}
# Live cameras: python -m src.main --spool-dir <CCTV_STORAGE_ROOT>/frames/<camera id> --camera-id <id> … (D-023)

# --- Storage ---
STORAGE_BACKEND=local            # local | azure
# Layout (decision D-023): <root>/<organization>/<campus>/ (photos, imports), <root>/recordings/… (routine,
# volatile), <root>/evidence/… (permanent vault), <root>/live/… (newest frame per camera), <root>/frames/…
# (CV spool). Every tier of a campus is erased when the campus is deleted.
CCTV_STORAGE_ROOT=/mnt/cctv_storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
# Disk-use levels for the platform health page and the low-storage notifications (D-019, D-023). These
# replace STORAGE_WARNING_THRESHOLD_PERCENT, which the API never read.
STORAGE_WARNING_PERCENT=80
STORAGE_CRITICAL_PERCENT=90

# --- Video ingestion, recordings and evidence (decision D-023) ---
# Shared secret of the ingestion service and the retention daemon (header X-Service-Token), separate
# from DETECTION_INGEST_TOKEN. Leave empty to switch the /internal/... service endpoints off.
INTERNAL_SERVICE_TOKEN=
RECORDING_RETENTION_DEFAULT_DAYS=7       # only until a campus sets its own retention (minutes/hours/days)
LIVE_SNAPSHOT_STALE_SECONDS=15           # older live frames are not served (the camera shows as "no recent frames")
ALERT_ESCALATION_POLL_SECONDS=15         # automatic escalation of unacknowledged alerts: check interval (0 = off)
REID_MODEL_MANIFEST=                     # Person Search by photo: path to the Re-ID model manifest (empty = photo search off)
REID_LIKELY_THRESHOLD=0.75               # similarity for LIKELY_MATCH when the manifest gives none
REID_UNCERTAIN_THRESHOLD=0.55            # weakest similarity shown (UNCERTAIN)
PERSON_SEARCH_MAX_RESULTS=50
CAMERA_HEALTH_CHECK_TIMEOUT_SECONDS=3
FFMPEG_PATH=ffmpeg                       # evidence clips and snapshots are cut with ffmpeg
EVIDENCE_CLIP_PRE_SECONDS=10             # clip from an alert: this long before the detection …
EVIDENCE_CLIP_POST_SECONDS=20            # … and this long after its last detection
EVIDENCE_CLIP_MAX_SECONDS=300            # longest clip saved from playback
STORAGE_NODE_NAME=primary

# services/video_ingestion (own .env or the environment; see its README):
# INGEST_API_BASE_URL=http://127.0.0.1:8000
# INGEST_SERVICE_TOKEN=                  # the same value as INTERNAL_SERVICE_TOKEN
# INGEST_STORAGE_ROOT=/mnt/cctv_storage  # the same disk as CCTV_STORAGE_ROOT
# INGEST_FRAME_SAMPLE_FPS=5
# INGEST_SEGMENT_SECONDS=60
# INGEST_OFFLINE_AFTER_SECONDS=15
# INGEST_FILE_SOURCES={}                 # {"<camera id>": "/path/video.mp4"}: recorded-file fallback
# services/storage_retention_daemon:
# RETENTION_API_BASE_URL=http://127.0.0.1:8000
# RETENTION_SERVICE_TOKEN=               # the same value as INTERNAL_SERVICE_TOKEN
# RETENTION_STORAGE_ROOT=/mnt/cctv_storage
# RETENTION_INTERVAL_SECONDS=300

# --- Real-time, in-app voice calls and push (decision D-025) ---
# WebSocket /api/v1/realtime/ws: signals only (IDs), the token travels in the first message.
REALTIME_HEARTBEAT_SECONDS=25            # clients ping at least this often; silent connections close after 2x
REALTIME_AUTH_TIMEOUT_SECONDS=10         # the first message must be {"type": "auth", "access_token": ...}
# In-app voice calls about an alert or a case (Guards, Supervisors, Admins):
#   none     calls answer 503 VOICE_CALL_NOT_CONFIGURED (default; nothing else changes)
#   livekit  LiveKit Cloud (free tier) or a self-hosted LiveKit server; the API only signs room tokens
VOICE_CALL_PROVIDER=none
LIVEKIT_URL=                             # e.g. wss://your-project.livekit.cloud (ws:// only for a local test server)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=                      # secret: never commit a real value
LIVEKIT_TOKEN_TTL_SECONDS=900            # how long a participant's room token can be used to connect (60-86400)
LIVEKIT_REQUEST_TIMEOUT_SECONDS=5        # closing a room when a call is ended (best effort)
# Push to locked phones (replaces the earlier unused FIREBASE_CREDENTIALS_PATH placeholder):
#   none  device tokens are stored, nothing is pushed (default)
#   fcm   Firebase Cloud Messaging HTTP v1 (Android); pushes carry no names or places, only the kind and IDs
PUSH_DELIVERY_MODE=none
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=                # path to the service-account JSON key, kept outside the repository
PUSH_POLL_SECONDS=5
PUSH_MAX_AGE_SECONDS=600                 # notifications older than this are never pushed
PUSH_REQUEST_TIMEOUT_SECONDS=10

# --- AI ---
CV_FRAME_SAMPLE_FPS=5
CV_WEIGHTS_DIR=/app/weights

# --- AI Investigation & Security Analytics Chatbot (decision D-027; read-only, no uploads) ---
# deterministic (default; offline, no model) | ollama (local Qwen2.5 on the GPU server) | openai_compatible
AI_LLM_PROVIDER=deterministic
AI_LLM_BASE_URL=                         # ollama: http://127.0.0.1:11434 ; openai_compatible: http://host:8000/v1
AI_LLM_MODEL=qwen2.5:7b                  # or qwen2.5:14b, or the fine-tuned "cctv-assistant" model from ml_training
AI_LLM_API_KEY=                          # only for an openai_compatible endpoint that needs one; never commit it
AI_LLM_TIMEOUT_SECONDS=30
AI_LLM_ALLOW_EXTERNAL=false              # a non-local AI_LLM_BASE_URL is refused unless true (redacted summaries only)
AI_CHAT_RETENTION_DAYS=30                # inactive chat sessions are purged by the storage retention daemon

# --- Internal service URLs ---
CORE_API_URL=http://core-api:8000
